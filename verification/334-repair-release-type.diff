+def validate_package_report_build(package_report: object) -> int:
+    """Validate the JSON integer boundary; BUILD stays a string for Info.plist."""
+    expected = int(BUILD)
+    if not isinstance(package_report, dict):
+        raise ValueError("package-report-build-mismatch")
+    reported = package_report.get("build")
+    # Reject coercible strings, floats, booleans and missing values, not merely
+    # different numbers. The independent package verifier emits a JSON integer.
+    if type(reported) is not int or reported != expected:
+        raise ValueError("package-report-build-mismatch")
+    return reported
+
